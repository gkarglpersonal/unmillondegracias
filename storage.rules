rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    function isAdmin() {
      return request.auth != null
        && request.auth.token.email == 'gerardo.kargl@gmail.com';
    }

    match /photos/{photoName} {
      // Lectura pública (URLs aparecen en la galería tras aprobación admin).
      allow read: if true;

      // Cualquiera puede subir si:
      //  - el archivo es imagen
      //  - pesa menos de 5 MB
      allow create: if
        request.resource.size < 5 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');

      // Solo admin puede borrar/sustituir.
      allow update, delete: if isAdmin();
    }
  }
}
