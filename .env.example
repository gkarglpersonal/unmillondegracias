# Firebase Web SDK config (project: mariangeles-viaje)
# Estos valores no son secretos: están restringidos por Firestore Security Rules.
# Encontrarlos en: Firebase Console -> Project Settings -> General -> Your apps -> Web app
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=mariangeles-viaje-32169.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=mariangeles-viaje-32169
VITE_FIREBASE_STORAGE_BUCKET=mariangeles-viaje-32169.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# EmailJS (https://www.emailjs.com/)
# Crear: Account -> API Keys (public key) y Email Services + Templates
VITE_EMAILJS_PUBLIC_KEY=
VITE_EMAILJS_SERVICE_ID=
VITE_EMAILJS_TEMPLATE_PANGEA=template_pangea
VITE_EMAILJS_TEMPLATE_ADMIN=template_admin

# Para el script de seed (NO compartir, NO commitear)
# Descargar desde: Firebase Console -> Project Settings -> Service accounts -> Generate new private key
GOOGLE_APPLICATION_CREDENTIALS=./service-account.json
