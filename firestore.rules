rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper: solo Gerry (admin) puede escribir cosas sensibles.
    function isAdmin() {
      return request.auth != null
        && request.auth.token.email == 'gerardo.kargl@gmail.com';
    }

    // ------------------------------------------------
    // tripItems — partidas del viaje (lectura pública)
    // ------------------------------------------------
    match /tripItems/{itemId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    // ------------------------------------------------
    // sections — agrupación de partidas (lectura pública)
    // El admin gestiona el orden y los nombres desde el panel.
    // ------------------------------------------------
    match /sections/{sectionId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    // ------------------------------------------------
    // messageWall — mirror público (nombre, mensaje, foto si aprobada)
    // Cualquiera puede crear con shape válido. Solo admin edita/borra.
    //
    // NOTA: rate limiting honesto requiere Cloud Functions. Sin ellas, no
    // hay forma de bloquear envíos repetidos del mismo email/IP en N segundos
    // desde rules. Mitigación actual: validación de formato + UI con
    // submittingRef anti doble-clic en ParticipationForm. Follow-up para
    // fase futura si aparece spam real.
    //
    // FK suave: validamos formato de contributionId y tripItemId si están
    // presentes. NO hacemos exists() porque costaría una read por write y
    // complicaría el flujo público sin beneficio proporcional.
    //  - contributionId: auto-ID de Firestore (20 chars alfanuméricos + `_-`).
    //  - tripItemId: rango más amplio (6-64 chars) porque las 29 partidas
    //    seedeadas usan IDs deterministas tipo `tripItem-01..29` (11 chars)
    //    y los creados desde admin usan auto-ID de Firestore (20 chars).
    // ------------------------------------------------
    match /messageWall/{messageId} {
      allow read: if true;

      // Privacidad: el cliente NUNCA puede crear un doc con photoUrl
      // poblado. Solo admin lo asigna al aprobar la foto (entonces el
      // blob se ha movido a photos/approved/, que es público).
      allow create: if
        request.resource.data.keys().hasAll(['name', 'createdAt', 'photoApproved', 'messageHidden', 'paid'])
        && request.resource.data.name is string
        && request.resource.data.name.size() >= 2
        && request.resource.data.name.size() <= 80
        && (request.resource.data.message == null || (request.resource.data.message is string && request.resource.data.message.size() <= 2000))
        && request.resource.data.photoApproved == false
        && request.resource.data.messageHidden == false
        && request.resource.data.paid == false
        && (!('photoUrl' in request.resource.data) || request.resource.data.photoUrl == null)
        && (!('photoStoragePath' in request.resource.data)
            || request.resource.data.photoStoragePath == null
            || (request.resource.data.photoStoragePath is string
                && request.resource.data.photoStoragePath.matches('^photos/pending/.*')))
        && (!('contributionId' in request.resource.data)
            || (request.resource.data.contributionId is string
                && request.resource.data.contributionId.matches('^[A-Za-z0-9_-]{20}$')))
        && (!('tripItemId' in request.resource.data)
            || request.resource.data.tripItemId == null
            || (request.resource.data.tripItemId is string
                && request.resource.data.tripItemId.matches('^[A-Za-z0-9_-]{6,64}$')));

      allow update, delete: if isAdmin();
    }

    // ------------------------------------------------
    // contributions — privado, solo admin lee
    // Cualquiera puede crear (formulario público). Email/monto privados.
    // ------------------------------------------------
    match /contributions/{contributionId} {
      allow read: if isAdmin();

      allow create: if
        request.resource.data.keys().hasAll(['name', 'email', 'paymentStatus', 'createdAt'])
        && request.resource.data.name is string
        && request.resource.data.name.size() >= 2
        && request.resource.data.name.size() <= 80
        && request.resource.data.email is string
        && request.resource.data.email.matches('^[^@\\s]+@[^@\\s]+\\.[^@\\s]+$')
        && request.resource.data.paymentStatus == 'pending'
        && (request.resource.data.amount == null || (request.resource.data.amount is number && request.resource.data.amount >= 0 && request.resource.data.amount <= 100000))
        && (!('message' in request.resource.data)
            || request.resource.data.message == null
            || (request.resource.data.message is string
                && request.resource.data.message.size() <= 2000))
        && (!('tripItemId' in request.resource.data)
            || request.resource.data.tripItemId == null
            || (request.resource.data.tripItemId is string
                && request.resource.data.tripItemId.matches('^[A-Za-z0-9_-]{6,64}$')));

      allow update, delete: if isAdmin();
    }

    // ------------------------------------------------
    // config/general — totales, hero copy editable
    // ------------------------------------------------
    match /config/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }
  }
}
